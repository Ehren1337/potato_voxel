-- Sharing metadata (25-community-and-ecosystem.md 3.2).  Read by tooling
-- and the manager detail pane; never by the loader's merge.
return {
  summary = "The overworld as a 3D diorama, and battles fought on it: real occlusion, over-the-shoulder fights. PotatoVoxel (fork of Dramatic Shape) is retuned for low-end devices: defaults pinned so a quad-A53/PowerVR/998MB handheld keeps its frame budget.",
  author = "ShaneMcGovernIE",
  contact = "https://github.com/ShaneMcGovernIE",
  tags = { "graphics", "3d", "voxel", "render-pipeline", "presentation",
           "battle", "low-end" },
  differences = {
    changed = {
      "PotatoVoxel (fork of Dramatic Shape Voxel Mod, formerly the TrimUI Brick build): the low-end tuning is the DEFAULT everywhere, and the VOXEL ladder is a set of quality MODES -- OFF / HIGH / MEDIUM / LOW / POTATO / CUSTOM. Picking a mode applies its tuned defaults to every quality knob (WATER, FOREST FX, AA, V-CURVE, V-GRID, 3D-BTL, SHADOWS) and to the RENDER SCALE knob (100% / 75% / 50% / 33%, folded back with ordinary canvas filtering; no dedicated upscaling shader or RCAS pass); touching any knob flips the mode to CUSTOM. HIGH keeps the full two-layer actor shadow map, including moving actor/sprite casters; MEDIUM and lower use contact/blob actor shadows. Every quality knob is tuned for a quad-A53/PowerVR/998MB device and DEFAULTS OFF -- WATER, FOREST FX, AA, V-CURVE, V-GRID, 3D-BTL (flat card battles) -- but each is a switchable row on the VOXEL SETTINGS submenu, and the voxel mesh build budget is halved per frame so chunk carving yields to gameplay on four cores. The engine's own rows keep their usual behaviour. There is one build for every device -- no desktop environment switch; terrain meshes persist in scoped mod.storage, with one profile token in the fingerprint so incompatible meshes are never served",
      "with VOXEL on, the overworld draws as 3D geometry instead of flat tiles",
      "occlusion comes from a depth buffer rather than a y-sort, so buildings really hide what is behind them",
      "with 3D-BTL ON, a battle draws over the map's nearest clear ground instead of over a white field",
      "with STADIUM SPRITES on, the same staged fight is skinned with the Pokemon Stadium battle models in place of the flat pics -- 148 of the 151 species, skinned and animated; Exeggutor, Tangela and Magmar have corrupt animation data at source and keep their battle sprites",
      "the map's NPCs are culled for the length of a battle, so the wipe plays over an empty map",
      "the engine's TILT and GBC FX rows are taken OFF the OPTIONS menu and held at off for as long as this mod is installed, while the keys they sit on (3 and 5) are left to the engine; uninstalling puts both rows back",
      "the BATTLE BG options row is taken OFF the menu and pinned to WHITE for as long as this mod is installed; uninstalling puts the row back",
      "a staged battle's camera can be steered by the player -- right stick, touch drag or mouse -- and the angle and lens carry into the next battle",
    },
    added = {
      "the VOXEL row and hotkey 8, the quality-mode ladder (OFF / HIGH / MEDIUM / LOW / POTATO / CUSTOM), each mode a tuned preset",
      "V-GRID and V-CURVE rows",
      "WATER row (OFF / SKY / FULL): the water surface becomes a field of pixel-tall voxel columns, reflecting the sky, the sun, the moon and the cast standing beside it",
      "3D-BTL row (OFF / ON): battles fought in 3D, the game's own pics stood up as cards -- and a STADIUM SPRITES row that skins the staged fight with the Pokemon Stadium battle models once a supported ROM is placed inside the mod",
      "BACK SPRITES options row (OFF / ON, off by default), which keeps your own Pokemon on the battle menu in its classic slot",
      "VR options row (OFF / ON, off by default): capability-gated PCVR through an engine-provided OpenXR/graphics API when available; the sandbox does not load raw FFI",
      "a day/night clock that reaches the flat 2D overworld as well as the diorama",
      "an opaque Town Map loading cover for cold asynchronous terrain builds, so the vanilla 2D world never flashes before the voxel mesh is ready",
      "an over-the-shoulder battle camera on a slow parallax orbit, with a depth-of-field pass that holds both mons sharp",
      "a generated sky behind the diorama, outdoor maps only",
      "a hand-authored tile shape profile (data/voxel_heights.lua) a mod can extend",
    },
    known = {
      "needs shader and depth-canvas support; without them the rows still cycle but the world stays 2D and battles draw plainly",
      "the STADIUM SPRITES row needs the Pokemon Stadium battle models, and the mod ships none of them -- they are that game's data. It must be Pokemon Stadium (US) 1.0 (md5 ed1378bc12115f71209a77844965ba50); place baseroms/baserom.z64 inside the mod, then the 151 models are built on a loading screen into scoped mod.storage, and the ROM itself is not copied",
      "three species -- Exeggutor, Tangela and Magmar -- have standby loops that are corrupt in the source extraction, and are held at their bind pose",
      "terrain meshes are cached per map in scoped mod.storage, so the first frame after entering a large map costs a build only when no matching record exists",
      "rooms have no ceilings, so a first-person look (VR) over an interior wall shows the void the diorama always had behind it",
      "VR needs a future engine-provided scoped OpenXR/graphics capability; without it the row remains safely unavailable",
    },
  },
  credits = {
    { who = "DramaticShape", for_ = "the upstream Dramatic Shape Voxel Mod (github.com/DramaticShape/DramaticShapeVoxelMod, v1.6.2) this mod is a fork of. Its own code carries no license; PotatoVoxel is a derived work, retuned for low-end devices. Upstream's OpenXR loader is no longer shipped here" },
    { who = "pret/pokered", for_ = "the tile and sprite data the geometry is derived from" },
    { who = "pret/pokestadium", for_ = "the decompilation the STADIUM extractor was written against -- the bone matrix chain and where scale is applied (func_800143C0), the rotation basis (func_8000F730), the animation and texture-animation samplers (func_80016FBC / func_80017540), the battle context slots and the move-id constants. No code or data from it is included or redistributed here; see README.md" },
    { who = "AverageConsumer", for_ = "battle UI/sprite interoperability (honouring the engine's visibility seams and composing staged-battle sprite overrides) and the cold mesh-build Town Map loading cover" },
  },
  compat = { engine = ">=0.1.37 <2.0.0", modApi = 2 },
}
